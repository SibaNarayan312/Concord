# Concord Application Configuration
PROJECT_NAME="Concord Inventory Reservation Service"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# MongoDB Configuration
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="concord"

# Redis Configuration
REDIS_URI="redis://localhost:6379/0"

# Inventory & Reservation Policies
DEFAULT_HOLD_TTL_SECONDS=30
EXPIRATION_WORKER_INTERVAL_SECONDS=2
RECONCILIATION_WORKER_INTERVAL_SECONDS=5
MAX_RESERVATION_QUANTITY=100
STREAM_MAX_LEN=10000

# WooCommerce Integration (Optional - falls back to Mock Mode if empty)
WC_STORE_URL="https://your-store.example.com"
WC_CONSUMER_KEY="ck_placeholder_consumer_key"
WC_CONSUMER_SECRET="cs_placeholder_consumer_secret"
WC_WEBHOOK_SECRET="whsec_placeholder_secret"
WC_HOLD_TTL_SECONDS=900
WC_STOCK_SYNC_ENABLED="true"
WC_VERIFY_WEBHOOK_SIGNATURE="true"
WC_MOCK_MODE="true"
